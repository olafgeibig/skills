# Template for the monitor-gate shim (consolidator wake-on-change, `--monitor-script` cron) — render at install time; variables: {skills_repo}, {store}, {publisher_repo}
# The helper is the publisher adapter; the monitor protocol is `--pending` only and
# prints sorted `pending <cid>` / `blocked <cid>` lines (or `error: monitor-unhealthy`).
# The consolidator job processes one pending candidate per wake; this shim only reports.
exec python3 "{skills_repo}/skills/skill-library-maintenance/scripts/skill-repo-consolidate.py" --pending --store "{store}" --repo "{publisher_repo}"
